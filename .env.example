# immich-edit connects to Immich through the in-app setup wizard; no server URL
# or API key is configured here. Open the app and complete setup on first run.

# Optional TOML configuration file. Environment variables override values from this file.
# IMMICH_EDIT_CONFIG=/path/to/config.toml

# Native dev with Vite uses 127.0.0.1:8088.
# Docker images default to 0.0.0.0:3000.
# BIND_ADDR=127.0.0.1:8088
# CACHE_DIR=./cache
# Native source runs: crates/backend/assets/dcp. Docker sets /app/assets/dcp.
# DCP_DIR=crates/backend/assets/dcp
# DATABASE_URL=sqlite://./cache/immich-edit.db?mode=rwc
# PREVIEW_MAX_EDGE=4096
# RENDER_MAX_CONCURRENCY=2
# MASK_CACHE_MB=1024
# RAW_FRAME_CACHE_MB=1024
# QUALITY_FRAME_CACHE_MB=512
# GPU_TEXTURE_CACHE_MB=512
# IMMICH_EDIT_RENDERER=auto
# ALLOWED_ORIGINS=http://localhost:5173
# MAX_BODY_MB=128
# ORIGINAL_TIMEOUT_SECS=120
# EXPORT_TIMEOUT_SECS=300
# IMMICH_EDIT_DEBUG=0
