# Optional TOML configuration file. Environment variables override values from this file.
# IMMICH_EDIT_CONFIG=/path/to/config.toml

# Native dev with Vite uses 127.0.0.1:8088.
# Docker images default to 0.0.0.0:3000.
# BIND_ADDR=127.0.0.1:8088
# Durable data: database, instance.key, imported profiles/LUTs, rendered rasters.
# Ephemeral caches live in a `cache/` subdirectory beneath it.
# DATA_DIR=./data
# CACHE_DIR is the deprecated alias for DATA_DIR; set DATA_DIR instead.
# Native source runs: crates/backend/assets/dcp. Docker sets /app/assets/dcp.
# DCP_DIR=crates/backend/assets/dcp
# DATABASE_URL=sqlite://./data/immich-edit.db?mode=rwc
# PREVIEW_MAX_EDGE=4096
# RENDER_MAX_CONCURRENCY=2
# MASK_CACHE_MB is a disk budget for rendered mask rasters, not memory.
# MASK_CACHE_MB=512
# EMBEDDING_CACHE_MB=512
# RAW_FRAME_CACHE_MB=512
# QUALITY_FRAME_CACHE_MB=512
# GPU_TEXTURE_CACHE_MB=512
# IMMICH_EDIT_RENDERER=auto
# SEGMENT_RUNTIME=auto
# SEGMENT_MAX_EDGE=2048
# SEGMENT_MAX_CONCURRENCY=1
# SEGMENT_IDLE_SECS=60
# ALLOWED_ORIGINS=http://localhost:5173
# MAX_BODY_MB=128
# ORIGINAL_TIMEOUT_SECS=120
# EXPORT_TIMEOUT_SECS=300
