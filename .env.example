IMMICH_URL=http://immich-server:2283
IMMICH_API_KEY=your-api-key-here
AUTH_TOKEN=

# Native dev with Vite uses 127.0.0.1:8088.
# Docker images default to 0.0.0.0:3000.
# BIND_ADDR=127.0.0.1:8088
# CACHE_DIR=./cache
# DATABASE_URL=sqlite://./cache/immich-edit.db?mode=rwc
# PREVIEW_MAX_EDGE=4096
# RENDER_MAX_CONCURRENCY=2
# MASK_CACHE_MB=1024
# RAW_FRAME_CACHE_MB=1024
# QUALITY_FRAME_CACHE_MB=512
# GPU_TEXTURE_CACHE_MB=512
# IMMICH_EDIT_RENDERER=auto
# ALLOWED_ORIGINS=http://localhost:5173
# MAX_BODY_MB=128
# ORIGINAL_TIMEOUT_SECS=120
# EXPORT_TIMEOUT_SECS=300
# IMMICH_EDIT_DEBUG=0
# IMMICH_EDIT_INSECURE=0
